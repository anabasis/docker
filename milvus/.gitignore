# -------------------------
# Docker / Docker Compose
# -------------------------
# 컨테이너 로그
*.log
logs/
docker-logs/

# Docker 빌드 캐시
**/.docker
**/.dockerignore

# Docker Compose override 파일
docker-compose.override.yml
docker-compose.override.yaml

# 환경 변수 파일
.env
.env.*
!.env.example

# -------------------------
# Milvus (로컬 스토리지)
